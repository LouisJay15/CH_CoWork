# Public build settings (safe to commit: nothing secret goes in a VITE_ variable).
# Set this to the site's real HTTPS origin, no trailing slash. Used for canonical tags, sitemap, Open Graph and JSON-LD.
VITE_SITE_URL=https://YOUR-PROJECT.lovable.app
# Where the booking API lives. Empty means the same origin as the site (the Python app serves both).
VITE_API_BASE=
