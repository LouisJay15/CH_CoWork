# Copy to api/.env (never commit the real file) or set these on your host.
ENVIRONMENT=production

# Supabase: Project Settings > API. Use the service role key: it stays on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=enquiries

# Outgoing email. Any SMTP provider works. Port 587 with STARTTLS, or 465 with SMTP_SECURITY=ssl.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender must be an address your SMTP provider lets you send from.
MAIL_FROM=Charles Hope Cowork website <bookings@charleshope.co.uk>
MAIL_TO=louis@charleshope.co.uk

# Only needed if the site is hosted on a different domain from this API (for example a Lovable URL).
ALLOWED_ORIGINS=
TRUST_PROXY=true
